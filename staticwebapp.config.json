{
  "routes": [
    {
      "route": "/rules",
      "rewrite": "/rules.html"
    },
    {
      "route": "/acknowledge",
      "rewrite": "/acknowledge.html"
    },
    {
      "route": "/50-principles",
      "rewrite": "/50-principles.html"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/*.html", "/*.css", "/*.js", "/*.png", "/*.pdf", "/*.ico", "/*.svg", "/*.json", "/*.txt", "/*.woff", "/*.woff2"]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html",
      "statusCode": 200
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN",
    "X-XSS-Protection": "1; mode=block",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
    "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self';"
  }
}
